{
  "crons": [{ "path": "/api/parent-permission-cleanup", "schedule": "0 3 * * *" }],
  "rewrites": [
    {
      "source": "/api/forms/(.*)",
      "destination": "/api/forms?slug=$1"
    },
    {
      "source": "/api/forms",
      "destination": "/api/forms"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

# Server-only values configured in Vercel. Local values go in an ignored .env.local file.
# Do not use VITE_ or NEXT_PUBLIC_ prefixes for secrets.
DATABASE_URL=
ENEMITES_API_KEY=

# Server-only marketing configuration. No marketing is sent by this app.
# Future senders must use lib/marketing.ts, and production must expose /api/unsubscribe.
MARKETING_OPERATOR_NAME=
MARKETING_POSTAL_ADDRESS=
PUBLIC_SITE_URL=
# Generate a random value with at least 32 bytes. Never put it in browser env vars.
MARKETING_UNSUBSCRIBE_SECRET=
